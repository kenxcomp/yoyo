{
  "description": "Optional repository-level override schema (<repo-root>/.t3-tri-plan.json) for t3-tri-plan v1.0.0. authorizedProviders is strictly forbidden here.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [1]
    },
    "designers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effortMode", "members"],
      "properties": {
        "effortMode": { "type": "string", "enum": ["unified", "per-model"] },
        "unifiedEffort": { "type": "string" },
        "members": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/modelSpec" }
        }
      }
    },
    "defaultReviewer": { "$ref": "#/$defs/modelSpec" },
    "judge": { "$ref": "#/$defs/modelSpec" },
    "reviewCouncil": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effortMode", "members"],
      "properties": {
        "effortMode": { "type": "string", "enum": ["unified", "per-model"] },
        "unifiedEffort": { "type": "string" },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/modelSpec" }
        }
      }
    },
    "knobs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roundCap": { "type": "integer", "minimum": 0 },
        "maxStepBacks": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "modelSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerInstanceId", "model", "effortKey", "effort"],
      "properties": {
        "providerInstanceId": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "effortKey": { "type": "string" },
        "effort": { "type": "string" }
      }
    }
  }
}
